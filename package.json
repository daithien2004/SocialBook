{
  "name": "socialbook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace=backend\" \"npm run start:worker:dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build:shared": "npm run build --workspace shared",
    "prepare": "husky"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@chroma-core/default-embed": "^0.1.9",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "next": "^16.3.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.tsx": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
