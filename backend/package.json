{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "seed": "npm run seed:reading-room-test",
    "seed:reading-room-test": "npm run build && node dist/src/seeds/run-reading-room-test.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "nest build",
    "prebuild": "npm run db:generate",
    "openapi:export": "node scripts/export-openapi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "npm run db:generate",
    "lint:architecture": "node scripts/check-module-boundaries.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "wait-on dist/worker.js && node --watch dist/worker.js",
    "start:worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:prune": "eslint \"{src,apps,libs,test}/**/*.ts\" --prune-suppressions",
    "check": "npm run typecheck && npm run lint && npm run lint:architecture && npm test",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
