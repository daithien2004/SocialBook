    "@socialbook/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "chromadb": "^3.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "epub2": "^3.0.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "multer": "^2.0.2",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.14.0",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.4",
    "tsconfig-paths": "^4.2.0",
