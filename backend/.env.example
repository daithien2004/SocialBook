# ================================================================
#  BACKEND .env EXAMPLE
#
#  Ký hiệu:
#    [REQUIRED]  — bắt buộc. App SẼ CRASH lúc boot (fail-fast qua schema
#                  zod trong src/config/env.validation.ts) nếu thiếu/sai.
#    [OPTIONAL]  — có giá trị mặc định trong src/config/env.config.ts,
#                  hoặc tính năng tương ứng bị tắt. Có thể để trống.
#
#  Muốn bỏ qua validation cho CI/test: SKIP_ENV_VALIDATION=true
# ================================================================

# ----------------------------------------------------------------
#  [REQUIRED]
# ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/socialbook?authSource=admin
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
# Google Login — bắt buộc, cùng client id với frontend
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ----------------------------------------------------------------
#  [OPTIONAL] Server
# ----------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------
#  [OPTIONAL] JWT thời hạn
# ----------------------------------------------------------------
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ----------------------------------------------------------------
#  [OPTIONAL] Seed admin (users.seeder) — DO NOT hardcode password in code
# ----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin2004@

# ----------------------------------------------------------------
#  [OPTIONAL] Email — Resend (transactional email qua HTTPS)
#  Dev local: để trống RESEND_API_KEY -> OTP được log ra console
#  (`[DEV MAILER]`) thay vì gửi mail thật. Production bắt buộc có key.
# ----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@socialbook.io.vn

# ----------------------------------------------------------------
#  [OPTIONAL] Cloudinary
# ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----------------------------------------------------------------
#  [OPTIONAL] External APIs
# ----------------------------------------------------------------
# Google Gemini (AI search/embedding)
GOOGLE_API_KEY=
# TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=BYtZrKUsiaR2iHNpf2uV
ELEVENLABS_MODEL_ID=eleven_v3
# Embedding
HUGGINGFACE_API_KEY=

# ----------------------------------------------------------------
#  [OPTIONAL] Content Moderation API
# ----------------------------------------------------------------
MODERATION_API_KEY=
MODERATION_API_BASE_URL=https://platform.beeknoee.com/v1
MODERATION_MODEL=gemini-2.5-flash-lite
MODERATION_TIMEOUT=15000

# ----------------------------------------------------------------
#  [OPTIONAL] AI Provider (gemini | chatgpt)
# ----------------------------------------------------------------
AI_PROVIDER=gemini

# ChatGPT (OpenAI-compatible provider)
CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-4o-mini
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_TIMEOUT=60000

# ----------------------------------------------------------------
#  [OPTIONAL] Redis — default là localhost
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------
#  [OPTIONAL] Chroma (chạy qua docker-compose)
# ----------------------------------------------------------------
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=socialbook_vectors

# ----------------------------------------------------------------
#  [OPTIONAL] Cache TTL (giây)
# ----------------------------------------------------------------
CACHE_TTL=900