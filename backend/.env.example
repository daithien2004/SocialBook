PORT=5000
MONGO_URI=mongodb://localhost:27017/socialbook?authSource=admin
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Email (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Moderation API (optional)
RAPID_MODER_API_KEY=
RAPID_API_HOST=
RAPID_API_URL=
MODERATION_API_KEY=
MODERATION_API_BASE_URL=
MODERATION_MODEL=gemini-2.5-flash
MODERATION_TIMEOUT=15000

# TTS (optional)
VOICERSS_API_KEY=

# Google Gemini AI (optional)
GOOGLE_API_KEY=

# HuggingFace (optional)
HUGGINGFACE_API_KEY=

# Redis (optional, defaults to localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
