NEXT_PUBLIC_NEST_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# [OPTIONAL] Cho phép backend gọi tới Next.js server (SSR) qua mạng nội bộ.
# Không set thì fallback sang NEXT_PUBLIC_NEST_API_URL.
NEST_API_INTERNAL_URL=

# OAuth Google/GitHub giờ do BACKEND giữ - xem backend/.env:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL
#   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_CALLBACK_URL
# Frontend chỉ gọi qua proxy /api/auth/* -> backend. Xem docs/env-guide.md.